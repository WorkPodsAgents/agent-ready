{
  "name": "@workpods/agent-ready",
  "author": "WorkPods.ai <yours@workpods.ai> (https://workpods.ai)",
  "version": "0.1.2",
  "description": "Free, open-source checker for how well AI search and AI agents can read and use a website. MCP server and CLI. Made by WorkPods.ai, an AI SEO agency.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agent-ready": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --external:@modelcontextprotocol/sdk --external:linkedom --external:ws --external:zod",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "linkedom": "0.18.15",
    "ws": "8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@open-agent-ready/core": "*",
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://workpods.ai/tools/agent-ready",
  "repository": {
    "type": "git",
    "url": "https://github.com/WorkPodsAgents/agent-ready.git",
    "directory": "bridge"
  },
  "bugs": {
    "url": "https://github.com/WorkPodsAgents/agent-ready/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "seo",
    "seo-audit",
    "seo-mcp",
    "geo",
    "axo",
    "ai-agents",
    "llms-txt",
    "robots-txt",
    "ai-search",
    "structured-data",
    "chrome-extension",
    "cli"
  ],
  "contributors": [
    {
      "name": "Shefali Munjal"
    }
  ],
  "mcpName": "ai.workpods/agent-ready"
}
