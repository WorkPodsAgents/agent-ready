{
  "name": "agent-ready",
  "author": "Shefali Munjal",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extension",
    "bridge"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && node plugin/scripts/lint-skills.mjs && npm run build",
    "sync:workpods": "node scripts/sync-from-workpods.mjs --from"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
